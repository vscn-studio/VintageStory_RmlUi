body { width: 100%; height: 100%; margin: 0dp; display: flex; align-items: center; justify-content: center; font-family: vsrmlui-default; font-size: 15dp; line-height: 24dp; color: #eee; background-color: #00000055; }
div { display: block; }
#folder-dialog { width: 760dp; max-width: 96%; height: 540dp; max-height: 94%; display: flex; flex-direction: column; background-color: #242424; border: 1dp #555; border-radius: 8dp; padding: 18dp; box-sizing: border-box; }
.folder-title { text-align: center; font-size: 20dp; margin-bottom: 18dp; flex-shrink: 0; }
button, input { box-sizing: border-box; height: 38dp; font-family: vsrmlui-default; font-size: 15dp; line-height: 24dp; color: #eee; background-color: #303030; border: 1dp #52545a; border-radius: 4dp; padding: 6dp 10dp; }
button { cursor: pointer; white-space: nowrap; }
button:hover { background-color: #454545; }
button:disabled { color: #777; }
.folder-address { display: flex; flex-shrink: 0; margin-bottom: 12dp; }
#address { flex: 1; min-width: 0dp; margin: 0dp 8dp; }
.folder-main { display: flex; flex: 1; min-height: 0dp; }
.folder-sidebar { width: 130dp; margin-right: 12dp; overflow-y: auto; }
.folder-sidebar button { display: block; width: 100%; margin-bottom: 6dp; text-align: left; }
.folder-list { flex: 1; min-width: 0dp; border: 1dp #414141; overflow-y: auto; }
.folder-list button { display: block; width: 100%; text-align: left; border-width: 0dp; border-radius: 0dp; overflow: hidden; text-overflow: ellipsis; }
#message { flex-shrink: 0; height: 44dp; overflow-y: auto; color: #aaa; font-size: 13dp; margin-top: 8dp; }
.folder-footer { display: flex; justify-content: flex-end; flex-shrink: 0; }
.folder-footer button { margin-left: 8dp; }
#choose { background-color: #365f9b; }
scrollbarvertical { width: 12dp; }
scrollbarvertical sliderbar { background-color: #666; min-height: 24dp; border-radius: 4dp; }
