.vs-midi-osc { width: 480dp; min-height: 110dp; background-color: #161b1a; border: 1dp #596761; }
.vs-midi-osc-header { display: flex; justify-content: space-between; padding: 9dp 12dp; color: #c5d8cf; border-bottom: 1dp #596761; font-weight: bold; }
.vs-midi-osc-log { padding: 14dp 12dp; font-family: vsrmlui-default; color: #50d5ad; }
