body { width: 100%; height: 100%; pointer-events: none; }
#tool-panel { position: absolute; left: 18%; top: 12%; width: 590dp; max-width: 86%; height: 480dp; max-height: 84%; overflow: hidden; pointer-events: auto; }
.tool-group-title { display: flex; align-items: center; height: 28dp; margin: 3dp 0dp 9dp; color: #d8d8d8; font-size: 13dp; border-bottom: 1dp #555555; }
.tool-form-row { display: flex; align-items: center; min-height: 34dp; margin: 4dp 0dp; }
.tool-form-row label { width: 135dp; flex-shrink: 0; color: #cccccc; }
.tool-form-row input.text, .tool-form-row select { width: 240dp; }
.tool-form-row input.range { width: 240dp; }
.tool-form-row span { min-width: 34dp; margin-left: 8dp; }
.tool-check { display: flex; align-items: center; min-height: 34dp; }
.tool-check label { margin-left: 8dp; }
#page-output, #page-advanced { display: none; }
#tool-panel.output-page #page-general, #tool-panel.advanced-page #page-general { display: none; }
#tool-panel.output-page #page-output, #tool-panel.advanced-page #page-advanced { display: block; }
.vs-theme-day .tool-group-title, .vs-theme-day .tool-form-row label { color: #493c2d; border-color: #b8aa97; }
@media (max-width: 680px) {
  #tool-panel { left: 2%; top: 4%; max-width: 96%; max-height: 92%; }
  .tool-form-row label { width: 95dp; }
  .tool-form-row input.text, .tool-form-row select, .tool-form-row input.range { flex: 1; width: auto; min-width: 0dp; }
}
