body { width: 100%; height: 100%; pointer-events: none; }
#panel { position: absolute; left: 8%; top: 5%; width: 760dp; max-width: 84%; max-height: 90%; overflow: auto; pointer-events: auto; }
#title { display: block; cursor: move; }
.hint { color: #d3c2a1; }
.field { display: flex; align-items: center; margin: 8dp 0; }
.field label { display: inline-block; width: 135dp; color: #d1d1d1; }
.field input.text { width: 260dp; }
.field input.small { width: 100dp; }
.field select { width: 260dp; }
#multiline { display: block; width: 100%; height: 100dp; margin-top: 5dp; box-sizing: border-box; }
.actions { display: block; margin-top: 10dp; }
.actions button { margin-right: 6dp; }
#status { color: #d3c2a1; min-height: 20dp; }
pre { display: block; }
#event-log { height: 150dp; overflow: auto; padding: 8dp; background-color: #111111; color: #dedede; font-family: vsrmlui-default; font-size: 12dp; }
.vs-theme-day .field label, .vs-theme-day #event-log { color: #29251f; }
.vs-theme-day #event-log { background-color: #ffffff; }
.vs-theme-day .hint, .vs-theme-day #status { color: #6a4c2d; }
@media (max-width: 720px) { #panel { left: 3%; max-width: 94%; } .field label { width: 110dp; } .field input.text, .field select { max-width: 60%; } }
