<rml>
<head>
  <title>RmlUi examples</title>
  <link type="text/rcss" href="vsrmlui:dialog/theme.rcss" />
  <link type="text/rcss" href="example.rcss" />
</head>
<body>
  <div id="panel" class="vs-window">
    <handle move_target="panel" id="title"><h1>RmlUi <span class="vs-muted">/ Vintage Story</span></h1></handle>
    <p class="vs-muted">[[vsrmluiexample:intro]]</p>
    <div class="vs-row"><label>[[vsrmluiexample:name]]</label><input id="name" class="text" type="text" value="VSCN-Studio" /></div>
    <div class="vs-row"><label>[[vsrmluiexample:theme]]</label><select id="theme"><option value="forest">[[vsrmluiexample:forest]]</option><option value="stone">[[vsrmluiexample:stone]]</option></select></div>
    <div class="vs-row"><label>[[vsrmluiexample:volume]]</label><input id="volume" class="range" type="range" min="0" max="100" step="1" value="50" /><span id="volume-value">50</span></div>
    <div class="vs-row"><input id="show-hud" class="checkbox" type="checkbox" /><label for="show-hud">[[vsrmluiexample:hud]]</label></div>
    <textarea>[[vsrmluiexample:textarea]]</textarea>
    <p id="status">[[vsrmluiexample:ready]]</p>
    <div class="vs-row"><button id="count">[[vsrmluiexample:count]]</button><button id="modal">[[vsrmluiexample:modal]]</button><button id="add">[[vsrmluiexample:add]]</button></div>
    <div id="items"><p>[[vsrmluiexample:list-intro]]</p></div>
    <div class="vs-row"><button id="close">[[vsrmluiexample:close]]</button><span class="vs-muted">Ctrl + F8 / Esc</span></div>
  </div>
</body>
</rml>
