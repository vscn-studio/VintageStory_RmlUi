body { width: 100%; height: 100%; background-color: #00000088; }
#box { position: absolute; left: 25%; top: 30%; width: 480dp; max-width: 50%; padding: 0dp; }
.modal-title { height: 40dp; line-height: 40dp; padding-left: 14dp; box-sizing: border-box; background-color: #2c2c2c; border-bottom: 1dp #414141; font-size: 15dp; font-weight: bold; }
.modal-content { min-height: 82dp; padding: 18dp 14dp; box-sizing: border-box; }
.modal-actions { display: flex; align-items: center; justify-content: flex-end; height: 46dp; padding: 6dp 12dp; box-sizing: border-box; background-color: #292929; border-top: 1dp #414141; }
.vs-theme-night .modal-title, .vs-theme-night .modal-actions { background-color: #181818; border-color: #434343; }
.vs-theme-day .modal-title, .vs-theme-day .modal-actions { background-color: #ded8cc; border-color: #b8aa97; }
.vs-theme-contrast .modal-title, .vs-theme-contrast .modal-actions { background-color: #141414; border-color: #d5d5d5; }
@media (max-width: 700px) { #box { left: 5%; max-width: 90%; } }
